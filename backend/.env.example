# DocuAI backend configuration.
# Copy to .env for local development outside Docker. Every variable is
# validated at boot (src/config/env.validation.ts); the API refuses to start
# on invalid configuration. Never commit a real .env file.

NODE_ENV=development
PORT=4310
API_PREFIX=api/v1
TRUST_PROXY=false
CORS_ORIGINS=
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- Database / cache ---------------------------------------------------------
# Host ports match docker-compose.yml (5433 / 6380). Use the service names
# (postgres / redis) when the API itself runs inside Docker.
DATABASE_URL=postgresql://docuai:docuai@localhost:5433/docuai
# Must differ from DATABASE_URL; the test suite refuses to run otherwise.
TEST_DATABASE_URL=postgresql://docuai:docuai@localhost:5433/docuai_test
REDIS_URL=redis://localhost:6380/0

# --- Global rate limiting -----------------------------------------------------
THROTTLE_LIMIT=100
THROTTLE_TTL=60

# --- Authentication (Phase 1) -------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters; the two secrets must differ; placeholders are rejected.
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW=60
AUTH_REFRESH_RATE_LIMIT=20
AUTH_REFRESH_RATE_WINDOW=60

# --- Object storage (Phase 2) -------------------------------------------------
# Any S3-compatible store works (AWS S3, Cloudflare R2, MinIO, RustFS, ...).
# docker-compose.yml runs a private RustFS instance on port 9000.
STORAGE_PROVIDER=s3
# Endpoint the API uses for HEAD/DELETE calls. Leave empty for AWS S3.
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs handed to clients. Leave empty when it is
# the same as S3_ENDPOINT (e.g. AWS). Inside Docker the API talks to
# http://storage:9000 while clients on the host use http://localhost:9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# Bucket must exist, be private and deny anonymous access.
S3_BUCKET=docuai-private
# Bucket used by the test suite (must differ from S3_BUCKET). Defaults to
# "<S3_BUCKET>-test".
TEST_S3_BUCKET=docuai-private-test
# Placeholders are rejected; the docker-compose development credentials are
# refused when NODE_ENV=production.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# true for MinIO/RustFS/most self-hosted stores, false for AWS virtual-host URLs.
S3_FORCE_PATH_STYLE=true
# Presigned URL lifetimes (seconds). Upload: 60..3600, download: 60..900.
S3_PRESIGNED_UPLOAD_EXPIRES_SECONDS=900
S3_PRESIGNED_DOWNLOAD_EXPIRES_SECONDS=300
# Create the private bucket at boot if missing. Defaults to true outside
# production and false in production (provision the bucket explicitly there).
S3_AUTO_CREATE_BUCKET=

# --- Documents (Phase 2) ------------------------------------------------------
# Maximum accepted file size in bytes (default 50 MiB).
MAX_DOCUMENT_FILE_SIZE_BYTES=52428800
# Comma-separated MIME allowlist for uploads.
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
# Per-IP limit for presigned URL generation (upload-url / download-url).
DOCUMENT_PRESIGN_RATE_LIMIT=30
DOCUMENT_PRESIGN_RATE_WINDOW=60

# --- OCR & text extraction (Phase 3) -----------------------------------------
# Requires Tesseract (with the language packs below) and Poppler utilities
# (pdfinfo, pdftotext, pdftoppm) on the PATH. The Docker image installs them.
OCR_ENABLED=true
# Start the background worker in this process. Set to false on API-only
# instances and true on a dedicated worker instance (same image, same env).
OCR_WORKER_ENABLED=true
# Default Tesseract language list (codes joined by "+").
OCR_DEFAULT_LANGUAGE=ind+eng
# Languages this deployment offers. Only codes whose trained data is actually
# installed are advertised; missing ones are reported by GET /health/ocr.
OCR_SUPPORTED_LANGUAGES=ind,eng,msa,ara,chi_sim,jpn,kor,deu,fra,spa
OCR_MAX_LANGUAGES_PER_JOB=3
OCR_QUEUE_NAME=docuai-ocr
# Jobs processed concurrently by one worker process (each job already runs
# Tesseract/Poppler in a subprocess).
OCR_MAX_CONCURRENCY=1
# Automatic retries for transient failures (storage/queue/worker interruption).
OCR_MAX_RETRIES=2
OCR_RETRY_BACKOFF_MS=5000
# Time budgets (ms): whole job / one page (render + recognise).
OCR_JOB_TIMEOUT_MS=600000
OCR_PAGE_TIMEOUT_MS=60000
# PROCESSING jobs without a heartbeat for this long are recovered or failed.
# The worker heartbeats at least every 10 s; default 120000 (2 minutes).
OCR_STALE_JOB_MS=120000
OCR_RECONCILE_INTERVAL_MS=60000
# Processing limits. File size defaults to MAX_DOCUMENT_FILE_SIZE_BYTES.
OCR_MAX_FILE_SIZE_BYTES=
OCR_MAX_PDF_PAGES=100
OCR_RENDER_DPI=150
OCR_MAX_RENDER_PIXELS=20000000
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_TEXT_PER_PAGE=200000
OCR_MAX_TEXT_PER_DOCUMENT=2000000
OCR_MAX_ACTIVE_JOBS_PER_USER=5
OCR_MAX_JOBS_PER_DOCUMENT=20
# Native PDF text is accepted (no OCR) when a page has at least this many
# characters and this share of letters/digits among non-space characters.
OCR_NATIVE_TEXT_MIN_CHARS=20
OCR_NATIVE_TEXT_MIN_ALNUM_RATIO=0.5
# Tool locations. Leave empty to use the PATH / default tessdata directory.
OCR_TESSERACT_PATH=
OCR_POPPLER_PATH=
OCR_TESSDATA_PREFIX=
OCR_TMP_DIR=
# Per-IP limit for POST /documents/:id/ocr and /ocr/retry.
OCR_REQUEST_RATE_LIMIT=10
OCR_REQUEST_RATE_WINDOW=60
